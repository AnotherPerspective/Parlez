<?xml version="1.0" encoding="UTF-8"?>
<!-- Parlez! "sveglia" (name provisional): an invisible CEP extension for After Effects, no window.
     Its only job is a clock that After Effects' modal windows cannot stop: see sveglia.js. -->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.anotherperspective.parlez.sveglia" ExtensionBundleVersion="PARLEZ_VERSION"
                   ExtensionBundleName="Parlez! sveglia"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.anotherperspective.parlez.sveglia.main" Version="PARLEZ_VERSION"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[24.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.anotherperspective.parlez.sveglia.main">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <!-- Node.js: to read the heartbeat file and whether After Effects' window is held by a modal one. -->
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>applicationActivate</Event>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size><Height>1</Height><Width>1</Width></Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
