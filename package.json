{
  "name": "parlez",
  "version": "0.1.1",
  "description": "Parlez! for Adobe® After Effects®: lets Claude work inside After Effects 2024–2026 through MCP, with confirmations, checkpoints, a pause switch and no internet access.",
  "keywords": [
    "adobe",
    "after-effects",
    "aftereffects",
    "claude",
    "extendscript",
    "mcp",
    "model-context-protocol",
    "motion-design",
    "motion-graphics",
    "parlez"
  ],
  "homepage": "https://github.com/AnotherPerspective/Parlez#readme",
  "bugs": {
    "url": "https://github.com/AnotherPerspective/Parlez/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Another Perspective Pictures SRL",
    "url": "https://github.com/anthonyfesce"
  },
  "contributors": [
    {
      "name": "kumo.productions, Inc.",
      "url": "https://github.com/kumoproductions"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnotherPerspective/Parlez.git"
  },
  "bin": {
    "mcp-aftereffects": "dist/index.js",
    "parlez": "dist/index.js"
  },
  "files": [
    "dist",
    "jsx",
    "recipes",
    "fixtures",
    "LICENSE",
    "AVVERTENZE.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc && node scripts/build-panel-images.mjs",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:jsx": "vitest run tests/lint-jsx.test.ts",
    "check:server-json": "node scripts/check-server-json.mjs",
    "docs:tools": "npm run build && node scripts/generate-tools-doc.mjs",
    "docs:tools:check": "npm run build && node scripts/generate-tools-doc.mjs --check",
    "check": "npm run typecheck && npm run typecheck:test && npm run lint && npm run format:check && npm run lint:jsx && npm run check:server-json && npm run docs:tools:check",
    "prepare": "lefthook install",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "preversion": "node scripts/release-changelog.mjs --check",
    "version": "node scripts/release-changelog.mjs && node scripts/sync-server-version.mjs && git add CHANGELOG.md server.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "mcpName": "io.github.anotherperspective/parlez"
}
